# 复制本文件为 .env.local 并填入真实值。
# .env.local 已被 .gitignore 忽略，不会提交；只有本 .env.example 会入库作模板。

# 站点正式域名，决定 canonical / OG / sitemap 的绝对链接。
NEXT_PUBLIC_SITE_URL=https://blog.linvin.net

# Gitalk 评论的 GitHub OAuth App 凭据。
# 必须用 NEXT_PUBLIC_ 前缀：Gitalk 在浏览器端使用，值会被打包进前端 JS
# (这是 Gitalk 的固有机制)。放到环境变量只是为了不把它们写进 git 历史。
NEXT_PUBLIC_GITALK_CLIENT_ID=
NEXT_PUBLIC_GITALK_CLIENT_SECRET=
